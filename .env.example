# ---------------------------------------------------------------------------
# LegalEase environment variables
# Copy to `.env.local` (local dev) and add the same keys in Vercel
# (Project → Settings → Environment Variables) for Production/Preview.
# Never commit real values. Only NEXT_PUBLIC_* values reach the browser.
# ---------------------------------------------------------------------------

# Public site URL (no trailing slash). Used for metadata and auth redirects.
# On Vercel use your production domain, e.g. https://legalease.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (required) ---------------------------------------------------
# Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS: used by admin actions and ingestion scripts.
# NEVER expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI assistant (required for RAG chat) ----------------------------------
# https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-key
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Embeddings (optional; keyword retrieval is used when unset) -----------
# EMBEDDING_PROVIDER=openrouter        # "openrouter" (default) or "openai"
# EMBEDDING_API_KEY=your-key           # falls back to OPENROUTER_API_KEY
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# EMBEDDING_BASE_URL=https://api.openai.com/v1

# --- Optional RAG / chat tuning --------------------------------------------
# LEGALEASE_MAX_HISTORY_MESSAGES=8
# LEGALEASE_MAX_RETRIEVED_CHUNKS=8
# LEGALEASE_MAX_CONTEXT_CHUNKS=6
# LEGALEASE_SIMILARITY_THRESHOLD=0.35
# LEGALEASE_CHAT_RATE_LIMIT=20

# --- Development only ------------------------------------------------------
# DANGER: disables the video join time window. Leave unset in production.
# VIDEO_SKIP_TIME_CHECK=false
