# ---------------------------------------------------------------------------
# LegalEase environment variables
# Copy to `.env.local` (local dev) and add the same keys in Vercel
# (Project → Settings → Environment Variables) for Production/Preview.
# Never commit real values. Only NEXT_PUBLIC_* values reach the browser.
# ---------------------------------------------------------------------------

# Public site URL (no trailing slash). Used for metadata and auth redirects.
# On Vercel use your production domain, e.g. https://legalease.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (required) ---------------------------------------------------
# Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS: used by admin actions and ingestion scripts.
# NEVER expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Google Gemini AI Engine (Primary - Free Tier) -----------------------
# Obtain free from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash

# --- Embeddings (defaults to Gemini text-embedding-004 + local fallback) ---
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=1536

# --- Optional RAG / chat tuning --------------------------------------------
# LEGALEASE_MAX_HISTORY_MESSAGES=8
# LEGALEASE_MAX_RETRIEVED_CHUNKS=8
# LEGALEASE_MAX_CONTEXT_CHUNKS=6
# LEGALEASE_SIMILARITY_THRESHOLD=0.35
# LEGALEASE_CHAT_RATE_LIMIT=20

# --- Stripe Sandbox Payment Gateway (Escrow & Webhooks) ---------------------
# Can also be configured live in Admin Dashboard → Platform Settings
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_CURRENCY=pkr

# --- SMTP Outbound & IMAP Inbound Email Notifications ----------------------
# Configurable live from Admin Dashboard → Platform Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_EMAIL=notifications@legalease.pk
SMTP_FROM_NAME=LegalEase Notifications

IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-imap-email@gmail.com
IMAP_PASS=your-app-password

# --- Development only ------------------------------------------------------
# DANGER: disables the video join time window. Leave unset in production.
# VIDEO_SKIP_TIME_CHECK=false
